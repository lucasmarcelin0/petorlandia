{
  "instrument_version": "sfa-2026-11-06",
  "title": "T0 — Entrevista inicial",
  "subtitle": "Instrumento revisado em 06/11/2026.",
  "submit_label": "Registrar T0",
  "sections": [
    {
      "title": "Participação e início dos sintomas",
      "fields": [
        {
          "key": "respondent_role",
          "label": "1. Quem está respondendo?",
          "type": "radio",
          "required": true,
          "options": [
            "A própria pessoa",
            "Pai, mãe ou responsável",
            "Outra pessoa autorizada"
          ]
        },
        {
          "key": "respondent_name",
          "label": "Nome e relação de quem responde",
          "type": "text",
          "required": false,
          "visible_if": {
            "source": "current",
            "key": "respondent_role",
            "operator": "selected_any",
            "values": [
              "Pai, mãe ou responsável",
              "Outra pessoa autorizada"
            ]
          }
        },
        {
          "key": "aceite_tcle",
          "label": "2. O consentimento para participar foi registrado conforme o TCLE do estudo?",
          "type": "checkboxes",
          "required": true,
          "options": [
            "Confirmo que li o TCLE e aceito participar voluntariamente do estudo."
          ],
          "help_text": "Sem consentimento, encerrar a entrevista."
        },
        {
          "key": "versao_tcle",
          "label": "Versão do TCLE",
          "type": "text",
          "required": false
        },
        {
          "key": "data_aceite",
          "label": "Data do aceite",
          "type": "date",
          "required": false
        },
        {
          "key": "data_inicio_sintomas",
          "label": "3. Em que dia começaram os sintomas desta doença?",
          "type": "date",
          "required": false,
          "prefill": "data_inicio_sintomas",
          "help_text": "D0 é o primeiro dia de sintomas. Se desconhecido, registrar para revisão."
        },
        {
          "key": "febre",
          "label": "4. Você teve febre ou sensação de febre nesta doença?",
          "type": "radio",
          "required": false,
          "options": [
            "Sim",
            "Não",
            "Não sei"
          ]
        },
        {
          "key": "temperatura_medida",
          "label": "Temperatura medida (°C), se disponível",
          "type": "text",
          "required": false
        },
        {
          "key": "data_temperatura",
          "label": "Data da medida",
          "type": "date",
          "required": false
        },
        {
          "key": "sinais_alerta_atuais",
          "label": "5. Você apresenta agora algum destes sinais?",
          "type": "checkboxes",
          "required": false,
          "options": [
            "Muita falta de ar",
            "Desmaio ou confusão",
            "Sangramento importante",
            "Piora muito forte ou preocupação urgente",
            "Nenhum destes sinais agora"
          ],
          "help_text": "Em caso de sinal de urgência, priorizar avaliação assistencial. Em emergência, procurar atendimento presencial ou ligar 192."
        }
      ]
    },
    {
