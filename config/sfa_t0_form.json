        {
          "key": "modo_entrevista",
          "label": "Como esta entrevista está sendo feita?",
          "type": "radio",
          "required": false,
          "options": [
            "Presencial",
            "Telefone",
            "Pela própria pessoa, pelo link"
          ],
          "help_text": "Data e hora do registro ficam gravadas automaticamente pelo sistema."
        },
        {
          "key": "entrevistador",
          "label": "Entrevistador(a)",
          "type": "text",
          "required": false,
          "visible_if": {
            "source": "current",
            "key": "modo_entrevista",
            "operator": "selected_any",
            "values": [
              "Presencial",
              "Telefone"
            ]
          }
        },
        {
          "key": "local_servico",
          "label": "Local/serviço",
          "type": "text",
          "required": false,
          "visible_if": {
            "source": "current",
            "key": "modo_entrevista",
            "operator": "selected_any",
            "values": [
              "Presencial",
              "Telefone"
            ]
          }
        },
        {
          "key": "momento_entrevista",
          "label": "Em que momento do atendimento a entrevista foi feita?",
          "type": "radio",
          "required": false,
          "options": [
            "Antes da consulta",
            "Depois da consulta",
            "Outro momento"
          ],
          "help_text": "Aplicação proposta: entre a triagem e a consulta médica. Registrar o momento real da entrevista.",
          "visible_if": {
            "source": "current",
            "key": "modo_entrevista",
            "operator": "selected_any",
            "values": [
              "Presencial",
              "Telefone"
