{
  "instrument_version": "sfa-2026-11-16b",
  "title": "T0 — Entrevista inicial",
  "subtitle": "Instrumento revisado em 16/11/2026. Entrevista inicial complementar ao SINAN. Primeiro, informações da pessoa; depois, informações sobre outras pessoas e exposições em comum.",
  "submit_label": "Registrar T0",
  "sections": [
    {
      "title": "Registro da entrevista",
      "description": "Preenchido pela equipe quando a entrevista é presencial ou por telefone.",
      "fields": [
        {
          "key": "modo_entrevista",
          "label": "Como esta entrevista está sendo feita?",
          "type": "radio",
          "required": false,
          "options": [
            "Presencial",
            "Telefone",
            "Pela própria pessoa, pelo link"
          ],
          "help_text": "Data e hora do registro ficam gravadas automaticamente pelo sistema."
        },
        {
          "key": "entrevistador",
          "label": "Entrevistador(a)",
          "type": "text",
          "required": false,
          "visible_if": {
            "source": "current",
            "key": "modo_entrevista",
            "operator": "selected_any",
            "values": [
              "Presencial",
              "Telefone"
            ]
          }
        },
        {
          "key": "local_servico",
          "label": "Local/serviço",
          "type": "text",
          "required": false,
          "visible_if": {
            "source": "current",
            "key": "modo_entrevista",
            "operator": "selected_any",
            "values": [
              "Presencial",
              "Telefone"
            ]
          }
        },
        {
          "key": "momento_entrevista",
          "label": "Em que momento do atendimento a entrevista foi feita?",
          "type": "radio",
          "required": false,
          "options": [
            "Antes da consulta",
            "Depois da consulta",
            "Outro momento"
          ],
          "help_text": "Aplicação proposta: entre a triagem e a consulta médica. Registrar o momento real da entrevista.",
          "visible_if": {
            "source": "current",
            "key": "modo_entrevista",
            "operator": "selected_any",
            "values": [
              "Presencial",
              "Telefone"
            ]
          }
        },
        {
          "key": "momento_entrevista_outro",
          "label": "Qual outro momento?",
          "type": "text",
          "required": false,
          "visible_if": {
            "source": "current",
            "key": "momento_entrevista",
            "operator": "equals",
            "value": "Outro momento"
          }
        }
      ]
    },
    {
      "title": "Participação e início dos sintomas",
      "fields": [
        {
          "key": "respondent_role",
          "label": "1. Quem está respondendo?",
          "type": "radio",
          "required": true,
          "options": [
            "A própria pessoa",
            "Pai, mãe ou responsável",
            "Outra pessoa autorizada"
          ]
        },
        {
          "key": "respondent_name",
          "label": "Se não for a própria pessoa, nome e relação",
          "type": "text",
          "required": false,
          "visible_if": {
            "source": "current",
            "key": "respondent_role",
            "operator": "selected_any",
            "values": [
              "Pai, mãe ou responsável",
              "Outra pessoa autorizada"
            ]
          },
          "help_text": "Nas próximas perguntas, “você” é a pessoa que adoeceu."
        },
        {
          "key": "participante_faixa_etaria",
          "label": "Qual é a idade da pessoa que participa do estudo?",
          "type": "radio",
          "required": true,
          "options": [
            "18 anos ou mais",
            "De 7 a 17 anos",
            "Menos de 7 anos"
          ],
          "help_text": "Para menores de 18 anos, quem aceita o TCLE é o pai, a mãe ou o responsável legal."
        },
        {
          "key": "aceite_tcle",
          "label": "2. O consentimento para participar foi registrado conforme o TCLE do estudo?",
          "type": "checkboxes",
          "required": true,
          "options": [
            "Confirmo que li o TCLE e aceito participar voluntariamente do estudo."
          ],
          "help_text": "Usar o TCLE aprovado, com comprovação do aceite e assentimento quando aplicável. Sem consentimento, encerrar a entrevista de pesquisa. A versão do TCLE e a data do aceite são registradas automaticamente pelo sistema."
        },
        {
          "key": "assentimento_tale",
          "label": "Assentimento da criança ou do adolescente (TALE)",
          "type": "checkboxes",
          "required": true,
          "options": [
            "A criança ou o adolescente ouviu ou leu o Termo de Assentimento, entendeu e concorda em participar."
          ],
          "help_text": "Se a criança ou o adolescente não quiser participar, a recusa vale mesmo com a autorização do responsável. Nesse caso, não envie o formulário.",
          "visible_if": {
            "source": "current",
            "key": "participante_faixa_etaria",
            "operator": "equals",
            "value": "De 7 a 17 anos"
          }
        },
        {
          "key": "data_inicio_sintomas",
          "label": "3. Em que dia começaram os sintomas desta doença?",
          "type": "date",
          "required": false,
          "prefill": "data_inicio_sintomas",
          "help_text": "D0 é o primeiro dia dos sintomas. Conferir com o SINAN; se houver diferença, registrar para revisão. T7 e T30 são agendados para 7 e 30 dias após esta entrevista inicial (T0)."
        },
        {
          "key": "data_inicio_sintomas_ignorada",
          "label": "Se não souber a data",
          "type": "checkboxes",
          "required": false,
          "options": [
            "Não sabe informar"
          ]
        },
        {
          "key": "sinais_alerta_atuais",
          "label": "4. Você apresenta agora algum destes sinais?",
          "type": "checkboxes",
          "required": false,
          "options": [
            "Muita falta de ar",
            "Desmaio ou confusão",
            "Sangramento importante",
            "Piora muito forte ou preocupação urgente",
            "Nenhum destes sinais agora"
          ],
          "help_text": "Se houver sinal de urgência, priorizar a avaliação assistencial. Em emergência, procurar atendimento presencial ou ligar 192."
        }
      ],
      "description": "Parte 1 — Informações individuais."
    },
