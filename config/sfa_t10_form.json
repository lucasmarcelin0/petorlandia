{
  "instrument_version": "collective-v2",
  "title": "T10 - Novas pistas e permanencia da fonte",
  "subtitle": "Atualizacao breve para descobrir novos casos, novas pistas e se uma possivel fonte continua ativa.",
  "submit_label": "Enviar acompanhamento T10",
  "sections": [
    {
      "title": "Evolucao e seguranca",
      "description": "Perguntamos apenas o que mudou desde o T0; identificacao e atendimentos municipais continuam vinculados nos bastidores.",
      "fields": [
        {
          "key": "classificacao_melhora",
          "label": "Como voce esta desde o T0?",
          "type": "radio",
          "required": true,
          "options": [
            "Recuperado(a)",
            "Melhorando",
            "Sem mudanca",
            "Piorando",
            "Melhorei e depois piorei"
          ]
        },
        {
          "key": "sinais_alerta_atuais",
          "label": "Voce apresenta agora algum destes sinais?",
          "type": "checkboxes",
          "required": true,
          "help_text": "Esta pergunta serve apenas para orientar nova avaliacao. Em emergencia, procure atendimento presencial ou ligue 192.",
          "options": [
            "Falta de ar importante",
            "Desmaio ou confusao",
            "Sangramento importante",
            "Piora intensa ou preocupacao urgente",
            "Nenhum destes sinais agora"
          ]
        },
        {
          "key": "retornou_servico_saude",
          "label": "Desde o T0, houve atendimento fora da rede municipal de Orlandia ou algum atendimento que possa nao estar no prontuario?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim"
          ]
        }
      ]
    },
    {
      "title": "Atualizacao diagnostica",
      "description": "Comparamos o que a pessoa entendeu com os registros disponiveis, sem tratar essa resposta como confirmacao laboratorial.",
      "fields": [
        {
          "key": "diagnostico_medico",
          "label": "Depois do T0, recebeu informacao nova sobre algum diagnostico ou suspeita?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim",
            "Exames pendentes",
            "Nao entendi o resultado"
          ]
        },
        {
          "key": "diagnostico_medico_status",
          "label": "Essa nova informacao foi apresentada como:",
          "type": "radio",
          "required": true,
          "options": [
            "Suspeita",
            "Confirmacao",
            "Descarte de uma suspeita anterior",
            "Nao sei"
          ],
          "visible_if": {
            "source": "current",
            "key": "diagnostico_medico",
            "operator": "equals",
            "value": "Sim"
          }
        },
        {
          "key": "diagnostico_medico_qual",
          "label": "Qual diagnostico ou suspeita foi informado agora?",
          "type": "select",
          "required": true,
          "options": [
            "Dengue",
            "Chikungunya",
            "Zika",
            "Virose ou sindrome viral indefinida",
            "Outra arbovirose",
            "Outra sindrome febril",
            "Outro"
          ],
          "visible_if": {
            "all": [
              {
                "source": "current",
                "key": "diagnostico_medico",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "current",
                "key": "diagnostico_medico_status",
                "operator": "nonempty"
              },
              {
                "source": "current",
                "key": "diagnostico_medico_status",
                "operator": "not_equals",
                "value": "Descarte de uma suspeita anterior"
              }
            ]
          }
        },
        {
          "key": "diagnostico_medico_qual_outro",
          "label": "Qual foi o outro diagnostico ou suspeita?",
          "type": "text",
          "required": true,
          "placeholder": "Escreva o diagnostico ou suspeita informado agora",
          "visible_if": {
            "source": "current",
            "key": "diagnostico_medico_qual",
            "operator": "equals",
            "value": "Outro"
          }
        }
      ]
    },
    {
      "title": "Novos vinculos e permanencia da fonte",
      "description": "Estas respostas ajudam a transformar uma pista individual em um sinal verificavel.",
      "fields": [
        {
          "key": "novos_casos_semelhantes",
          "label": "Depois do T0, voce soube de outra pessoa com sintomas parecidos?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim",
            "Nao sei"
          ]
        },
        {
          "key": "novos_casos_quantidade",
          "label": "Aproximadamente quantas novas pessoas adoeceram?",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 99,
          "step": 1,
          "visible_if": {
            "source": "current",
            "key": "novos_casos_semelhantes",
            "operator": "equals",
            "value": "Sim"
          }
        },
        {
          "key": "novos_casos_local_periodo",
          "label": "Onde e quando essas pessoas adoeceram?",
          "type": "textarea",
          "required": true,
          "placeholder": "Local + data ou periodo aproximado",
          "visible_if": {
            "source": "current",
            "key": "novos_casos_semelhantes",
            "operator": "equals",
            "value": "Sim"
          }
        },
        {
          "key": "nova_pista_exposicao",
          "label": "Surgiu alguma nova pista sobre alimento, produto, agua, animal, lugar, trabalho, evento ou atividade?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim",
            "Nao sei"
          ]
        },
        {
          "key": "nova_pista_detalhe",
          "label": "Qual foi a nova pista?",
          "type": "textarea",
          "required": true,
          "help_text": "Inclua o que, onde e quando; marca, origem ou especie quando houver.",
          "visible_if": {
            "source": "current",
            "key": "nova_pista_exposicao",
            "operator": "equals",
            "value": "Sim"
          }
        },
        {
          "key": "fonte_ainda_ativa",
          "label": "A possivel fonte ou situacao ainda existe?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim",
            "Nao sei"
          ],
          "visible_if": {
            "any": [
              {
                "source": "current",
                "key": "novos_casos_semelhantes",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "current",
                "key": "nova_pista_exposicao",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "prior",
                "key": "outras_pessoas_com_sintomas",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "prior",
                "key": "exposicao_ambiental_outros_doentes",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "prior",
                "key": "exposicao_animal_outros_doentes",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "prior",
                "key": "exposicao_alimentar",
                "operator": "selected_any",
                "values": [
                  "Outras pessoas que consumiram tambem adoeceram"
                ]
              },
              {
                "all": [
                  {
                    "source": "prior",
                    "key": "vinculo_exposicao_suspeita",
                    "operator": "nonempty"
                  },
                  {
                    "source": "prior",
                    "key": "vinculo_exposicao_suspeita",
                    "operator": "not_equals",
                    "value": "Nao sei"
                  }
                ]
              },
              {
                "source": "prior",
                "key": "outra_exposicao_suspeita",
                "operator": "nonempty"
              }
            ]
          }
        },
        {
          "key": "outras_pessoas_ainda_expostas",
          "label": "Outras pessoas ainda podem estar expostas?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim",
            "Nao sei"
          ],
          "visible_if": {
            "any": [
              {
                "source": "current",
                "key": "novos_casos_semelhantes",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "current",
                "key": "nova_pista_exposicao",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "prior",
                "key": "outras_pessoas_com_sintomas",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "prior",
                "key": "exposicao_ambiental_outros_doentes",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "prior",
                "key": "exposicao_animal_outros_doentes",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "prior",
                "key": "exposicao_alimentar",
                "operator": "selected_any",
                "values": [
                  "Outras pessoas que consumiram tambem adoeceram"
                ]
              },
              {
                "all": [
                  {
                    "source": "prior",
                    "key": "vinculo_exposicao_suspeita",
                    "operator": "nonempty"
                  },
                  {
                    "source": "prior",
                    "key": "vinculo_exposicao_suspeita",
                    "operator": "not_equals",
                    "value": "Nao sei"
                  }
                ]
              },
              {
                "source": "prior",
                "key": "outra_exposicao_suspeita",
                "operator": "nonempty"
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Carga adicional desde o T0",
      "description": "Nao repita os valores do T0; informe somente o que ocorreu depois daquele contato.",
      "fields": [
        {
          "key": "dias_incap_novos",
          "label": "Quantos dias adicionais ficou completamente sem suas atividades desde o T0?",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "key": "houve_novos_gastos",
          "label": "Houve novos gastos desde o T0?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim"
          ]
        },
        {
          "key": "custo_outros",
          "label": "Valor total aproximado dos novos gastos (R$)",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 99999,
          "step": 0.01,
          "visible_if": {
            "source": "current",
            "key": "houve_novos_gastos",
            "operator": "equals",
            "value": "Sim"
          }
        },
        {
          "key": "perda_renda",
          "label": "Houve perda de renda desde o T0?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim",
            "Nao sei"
          ]
        }
      ]
    }
  ]
}
