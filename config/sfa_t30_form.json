{
  "instrument_version": "collective-v2",
  "title": "T30 - Encerramento do risco coletivo",
  "subtitle": "Encerramento breve do episodio e do possivel risco coletivo, sem repetir a historia anterior.",
  "submit_label": "Enviar acompanhamento T30",
  "sections": [
    {
      "title": "Encerramento individual e seguranca",
      "description": "A recuperacao individual permanece como informacao complementar; o foco e saber se o risco coletivo foi esclarecido.",
      "fields": [
        {
          "key": "estado_saude_final",
          "label": "Como voce se sente hoje comparado a antes da doenca?",
          "type": "radio",
          "required": true,
          "options": [
            "Recuperado(a) - como antes da doenca",
            "Quase recuperado(a) - diferencas minimas",
            "Melhor, mas ainda com alguma limitacao",
            "Pouco melhor ou sem melhora",
            "Pior do que antes"
          ]
        },
        {
          "key": "sinais_alerta_atuais",
          "label": "Voce apresenta agora algum destes sinais?",
          "type": "checkboxes",
          "required": true,
          "help_text": "Esta pergunta serve apenas para orientar nova avaliacao. Em emergencia, procure atendimento presencial ou ligue 192.",
          "options": [
            "Falta de ar importante",
            "Desmaio ou confusao",
            "Sangramento importante",
            "Piora intensa ou preocupacao urgente",
            "Nenhum destes sinais agora"
          ]
        },
        {
          "key": "retorno_atividades_normais",
          "label": "Como esta seu retorno as atividades habituais?",
          "type": "radio",
          "required": true,
          "options": [
            "Retorno completo",
            "Retorno parcial",
            "Ainda nao retornei"
          ]
        }
      ]
    },
    {
      "title": "Informacao diagnostica final",
      "description": "Esta e a informacao que a pessoa entendeu; ela sera comparada aos sistemas e resultados disponiveis.",
      "fields": [
        {
          "key": "diagnostico_medico",
          "label": "Depois do ultimo contato, recebeu informacao nova sobre algum diagnostico ou suspeita?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim",
            "Exames pendentes",
            "Nao entendi o resultado"
          ]
        },
        {
          "key": "diagnostico_medico_status",
          "label": "Essa nova informacao foi apresentada como:",
          "type": "radio",
          "required": true,
          "options": [
            "Suspeita",
            "Confirmacao",
            "Descarte de uma suspeita anterior",
            "Nao sei"
          ],
          "visible_if": {
            "source": "current",
            "key": "diagnostico_medico",
            "operator": "equals",
            "value": "Sim"
          }
        },
        {
          "key": "diagnostico_medico_qual",
          "label": "Qual diagnostico ou suspeita foi informado agora?",
          "type": "select",
          "required": true,
          "options": [
            "Dengue",
            "Chikungunya",
            "Zika",
            "Virose ou sindrome viral indefinida",
            "Outra arbovirose",
            "Outra sindrome febril",
            "Outro"
          ],
          "visible_if": {
            "all": [
              {
                "source": "current",
                "key": "diagnostico_medico",
                "operator": "equals",
                "value": "Sim"
              },
              {
                "source": "current",
                "key": "diagnostico_medico_status",
                "operator": "nonempty"
              },
              {
                "source": "current",
                "key": "diagnostico_medico_status",
                "operator": "not_equals",
                "value": "Descarte de uma suspeita anterior"
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Fechamento do possivel risco coletivo",
      "description": "Perguntas de encerramento aparecem quando existe sinal anterior ou nova informacao.",
