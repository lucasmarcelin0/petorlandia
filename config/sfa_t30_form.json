        {
          "key": "novos_casos_quantidade_ignorada",
          "label": "Se não souber quantas",
          "type": "checkboxes",
          "required": false,
          "options": [
            "Não sei"
          ],
          "visible_if": {
            "source": "current",
            "key": "novos_casos_semelhantes",
            "operator": "equals",
            "value": "Sim"
          },
          "inline_with": "novos_casos_quantidade"
