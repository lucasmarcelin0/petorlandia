            "Leptospirose",
            "Febre maculosa",
            "COVID-19 ou gripe",
            "Virose",
            "Febre sem causa definida",
            "Intoxicação alimentar",
            "Outra",
            "Não lembro"
          ],
          "visible_if": {
            "source": "current",
            "key": "diagnostico_medico",
            "operator": "equals",
            "value": "Sim"
