        {
          "key": "novos_casos_semelhantes",
          "label": "Desde o ultimo contato, voce soube de novos casos parecidos?",
          "type": "radio",
          "required": true,
          "options": [
            "Nao",
            "Sim",
            "Nao sei"
          ]
        },
        {
          "key": "novos_casos_quantidade",
          "label": "Aproximadamente quantas novas pessoas adoeceram?",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 99,
          "step": 1,
          "visible_if": {
            "source": "current",
